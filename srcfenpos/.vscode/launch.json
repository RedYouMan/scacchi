{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "g++.exe - Compila ed esegui il file attivo",
            "type": "cppdbg",
            "request": "launch",
            "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "setupCommands": [
                {
                    "description": "Abilita la formattazione automatica per gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Abilita interruzione da tastiera",
                    "text": "handle SIGINT nostop print pass",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "C/C++: g++.exe compila il file attivo",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}
