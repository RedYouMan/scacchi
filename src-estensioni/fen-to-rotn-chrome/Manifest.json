
{
  "manifest_version": 3,
  "name": "ROTN Converter Rosario Turco",
  "version": "1.3.0",
  "description": "Converte FEN in ROTN - Tasto Destro",
  "permissions": ["clipboardWrite", "contextMenus", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
